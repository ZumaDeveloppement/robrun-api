# Copie ce fichier en « .env » et adapte. Rien n'est obligatoire : sans .env, l'API démarre avec les valeurs par défaut.

# Port d'écoute (sur un hébergeur, utilise le port qu'il te donne)
PORT=3000
HOST=0.0.0.0

# ID Steam du jeu (ROB RUN = 4262460)
STEAM_APP_ID=4262460

# Jeton secret que le BOT utilise pour envoyer les stats de la communauté (POST /v1/internal/community).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Laisse vide pour désactiver l'envoi (les routes /community et /leaderboard répondront « indisponible »).
API_TOKEN=

# Sites autorisés à appeler l'API depuis un navigateur (CORS), séparés par des virgules. * = tout le monde (lecture seule).
ALLOWED_ORIGINS=*

# Requêtes autorisées par minute et par adresse IP
RATE_LIMIT=60

# À 1 SEULEMENT si l'API est derrière un proxy de confiance (nginx, Cloudflare…) : l'IP réelle est alors lue dans X-Forwarded-For
TRUST_PROXY=0
